{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./templates/next-dashboard/src/*", "./packages/ui/*"]
    }
  },
  "include": ["packages/**/*", "templates/next-dashboard/src/lib/**/*", "templates/next-dashboard/src/hooks/**/*"],
  "exclude": ["node_modules", "templates/*/node_modules"]
}
