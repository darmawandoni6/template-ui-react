{
  "name": "template-ui-react",
  "version": "2.1.0",
  "description": "A CLI tool to quickly scaffold React projects with a ready-to-use UI template and modern best practices.",
  "type": "module",
  "main": "./bin/index.js",
  "bin": {
    "template-ui-react": "./bin/index.js"
  },
  "scripts": {
    "sync:ui": "node scripts/sync-ui.js",
    "lint": "eslint .",
    "format": "prettier --write packages/ui && node scripts/sync-ui.js && prettier --write .",
    "knip": "knip"
  },
  "keywords": [
    "react",
    "react-cli",
    "react-template",
    "ui-template",
    "ui-kit",
    "frontend",
    "boilerplate",
    "scaffold",
    "cli"
  ],
  "author": {
    "name": "Doni Darmawan",
    "email": "darmawandoni6@gmail.com"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/darmawandoni6/template-ui-react.git"
  },
  "homepage": "https://github.com/darmawandoni6/template-ui-react",
  "bugs": {
    "url": "https://github.com/darmawandoni6/template-ui-react/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^14.0.0",
    "inquirer": "^12.6.3",
    "ora": "^8.2.0",
    "shelljs": "^0.10.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.0.0-alpha.0",
    "@eslint/js": "^9.39.2",
    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/shelljs": "^0.8.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "knip": "^5.78.0",
    "lucide-react": "^0.475.0",
    "prettier": "^3.5.1",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3"
  }
}
